APP_NAME="Hadir.In"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokal memakai SQLite agar tidak perlu memasang pdo_pgsql.
# Berkas database dibuat oleh perintah di README.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolut/path/ke/database.sqlite

# Produksi memakai PostgreSQL 16. Ekstensi pdo_pgsql wajib aktif.
# Untuk beralih ke PostgreSQL, komentari blok SQLite di atas lalu isi:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=hadir
# DB_USERNAME=hadir
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="halo@hadir.in"
MAIL_FROM_NAME="${APP_NAME}"

# Akun platform admin dibuat lewat seeder lokal.
PLATFORM_ADMIN_EMAIL=platform@hadir.test

VITE_APP_NAME="${APP_NAME}"
